# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=
DNS_SERVERS=8.8.8.8,8.8.4.4

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImgBB (used by client, not server)
IMGBB_API_KEY=

# Email (SMTP - optional, for booking notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Frontend URL
CLIENT_URL=http://localhost:3000
