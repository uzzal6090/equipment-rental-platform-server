# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=
DNS_SERVERS=8.8.8.8,8.8.4.4
DB_NAME=equipment_rental_db

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe local test mock (optional, NODE_ENV=test only)
# STRIPE_API_HOST=localhost
# STRIPE_API_PROTOCOL=http
# STRIPE_API_PORT=12111

# ImgBB
IMGBB_API_KEY=

# Frontend URL
CLIENT_URL=http://localhost:3000

# Note: VERCEL=1 is automatically injected by Vercel platform.
# Do not set this manually; it controls serverless vs. local listening behavior.
